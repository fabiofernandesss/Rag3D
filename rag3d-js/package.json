{
  "name": "rag3d",
  "version": "0.1.0",
  "description": "RAG3D — RAG tridimensional: 3 eixos, fusão por interferência quântica, Hologramas Textuais (vetores em Postgres puro, sem pgvector), memória infinita, qualquer LLM. Índice compatível bit a bit com a versão Python.",
  "author": "Fabio Fernandes Jesus <fabiofernandesjesus@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/fabiofernandesss/Rag3D",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "rag3d": "src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "build:web": "esbuild web/client/app.jsx --bundle --outfile=web/public/bundle.js --loader:.jsx=jsx --jsx=automatic --minify",
    "web": "node web/server.js"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  },
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "marked": "^18.0.5",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
