# RAG3D — variáveis de ambiente (copie para .env ou exporte no shell).
# NENHUMA chave de API deve ser commitada.

# Postgres SEM pgvector (deixe vazio para usar store local: SQLite no Python,
# JSON no JS). Sobe com `docker compose up -d`.
RAG3D_PG=postgresql://postgres:rag3d@localhost:5433/rag3d

# LLM (leitura das respostas). Qualquer provedor OpenAI-compatível.
# DeepSeek:
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=coloque_sua_chave_aqui
RAG3D_LLM_MODEL=deepseek-chat

# Encoder: auto (tenta BGE-M3), bge-m3, ou fallback (hashing, zero-dep).
# RAG3D_ENCODER=auto

# Diretório de dados local (índice/JSON quando não usa Postgres).
# RAG3D_DATA=~/.rag3d
