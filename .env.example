# RAG3D — variáveis de ambiente (copie para .env ou exporte no shell).
# NENHUMA chave de API deve ser commitada.

# Postgres SEM pgvector (deixe vazio para usar store local: SQLite no Python,
# JSON no JS). Sobe com `docker compose up -d`.
RAG3D_PG=postgresql://postgres:rag3d@localhost:5433/rag3d

# Backend pgvector opt-in (profile Docker separado). Defina uma senha local
# antes de executar `docker compose --profile pgvector up -d pgvector`.
RAG3D_PGVECTOR_PASSWORD=
# RAG3D_BACKEND=pgvector
# RAG3D_PG=postgresql://postgres:SENHA@127.0.0.1:5434/rag3d
# RAG3D_PGVECTOR_SEARCH_MODE=exact
# RAG3D_PGVECTOR_STATEMENT_TIMEOUT_MS=5000

# Retrieval Engine V2 (rollout opt-in; rollback está documentado separadamente).
# RAG3D_BACKEND=sqlite
# RAG3D_RETRIEVAL_PIPELINE=v2
# RAG3D_FUSION=rrf
# RAG3D_STRUCTURAL_RERANK=true
# RAG3D_RERANKER=none
# RAG3D_DIVERSITY_METHOD=none
# RAG3D_ALLOW_ENCODER_FALLBACK=false

# LLM (leitura das respostas). Qualquer provedor OpenAI-compatível.
# DeepSeek:
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=coloque_sua_chave_aqui
RAG3D_LLM_MODEL=deepseek-chat

# Encoder: auto (tenta BGE-M3), bge-m3, ou fallback (hashing, zero-dep).
# RAG3D_ENCODER=auto

# Diretório de dados local (índice/JSON quando não usa Postgres).
# RAG3D_DATA=~/.rag3d
